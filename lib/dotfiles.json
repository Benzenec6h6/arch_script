{
  "hyprland": [
    {
      "name": "mylinuxforwork",
      "url": "https://github.com/mylinuxforwork/dotfiles",
      "method": [
        "mkdir -p $HOME/Projects",
        "git clone --depth 1 https://github.com/mylinuxforwork/dotfiles $HOME/Projects/dotfiles",
        "cd $HOME/Projects/dotfiles/setup",
        "./setup-arch.sh",
        "cd $HOME/Projects/dotfiles",
        "stow dotfiles"
      ]
    },
    {
      "name": "JaKooLit",
      "url": "https://github.com/JaKooLit/Arch-Hyprland.git",
      "method": [
        "git clone --depth=1 https://github.com/JaKooLit/Arch-Hyprland.git $HOME/Arch-Hyprland",
        "cd $HOME/Arch-Hyprland",
        "chmod +x install.sh",
        "./install.sh"
      ]
    },
    {
      "name": "end-4",
      "url": "https://github.com/end-4/dots-hyprland.git",
      "method": [
        "git clone --depth=1 https://github.com/end-4/dots-hyprland.git",
        "cd $HOME/dots-hyprland",
        "chmod +x install.sh",
        "./install.sh"
      ]
    },
    {
      "name": "HyDE-Project",
      "url": "https://github.com/HyDE-Project/HyDE.git",
      "method": [
        "git clone --depth=1 https://github.com/HyDE-Project/HyDE $HOME/HyDE",
        "cd $HOME/HyDE/Scripts",
        "./install.sh"
      ]
    },
    {
      "name": "Matt-FTW",
      "url": "https://github.com/Matt-FTW/dotfiles.git",
      "method": [
        "git clone https://github.com/Matt-FTW/dotfiles.git",
        "cd $HOME/dotfiles",
        "cp -r .config/* $HOME/.config/",
        "cp -r .local/bin/* $HOME/.local/bin/"
      ]
    }
  ],
  "xmonad": [
    {
      "name": "Axarva",
      "url": "https://github.com/Axarva/dotfiles-2.0.git",
      "method": [
        "git clone https://github.com/Axarva/dotfiles-2.0.git $HOME/dotfiles-2.0",
        "cd $HOME/dotfiles-2.0",
        "chmod +x install-on-arch.sh",
        "./install-on-arch.sh",
        "ln -s /usr/lib/libasan.so.8 /usr/lib/libasan.so.6"
      ]
    }
  ]
}
